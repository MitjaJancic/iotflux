# lab-scope.env - Advisory target boundary for IoTFlux
# Nothing is blocked: out-of-boundary targets are logged and assessed anyway.
# Edit ALLOWED_SUBNETS to match your network so the log stays quiet.
ALLOWED_SUBNETS=192.168.1.230/32,10.10.0.0/16,10.42.0.0/16,172.30.0.0/24,172.28.0.0/16,127.0.0.0/8
DENIED_SUBNETS=192.168.0.0/16,10.0.0.0/8,0.0.0.0/0
SCOPE_VALIDATION_MODE=enforce  # advisory in practice: enforce/warn/dry-run no longer block
