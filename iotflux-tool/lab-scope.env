# lab-scope.env - Allowed subnets for IoTFlux Validation Lab (fail-closed)
# Only the isolated Docker lab + localhost. Add a physical CIDR when you isolate a real device.
ALLOWED_SUBNETS=172.28.0.0/24,127.0.0.0/8
DENIED_SUBNETS=0.0.0.0/0
SCOPE_VALIDATION_MODE=enforce  # Options: enforce, warn, dry-run
